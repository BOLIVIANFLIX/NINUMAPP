# Copiar a .env y rellenar en local. Estas son variables EXPO_PUBLIC_* -- viajan
# dentro del propio bundle de la app (no son secretas, no poner claves aquí).

# URL del backend. En desarrollo, se puede dejar vacía: api.ts usa un valor por
# defecto (10.0.2.2:8000 en el emulador Android, localhost:8000 en el resto).
EXPO_PUBLIC_API_URL=

# Enlace del calendario de Google (compartido, público o "solo lectura para quien
# tenga el enlace"). Si se deja vacío, la pestaña Calendario avisa que falta configurar.
EXPO_PUBLIC_GOOGLE_CALENDAR_URL=
