# Copiar a .env y rellenar. En desarrollo local, DATABASE_URL puede dejarse tal cual
# (SQLite). En producción (VPS), cambiar a una URL de Postgres, p.ej.:
# postgresql+asyncpg://usuario:contraseña@host:5432/ninumapp

DATABASE_URL=sqlite+aiosqlite:///./ninumapp.db

# Home Assistant y Grocy viven en la Raspberry -- se consultan por red, pero nunca
# bloquean el resto de la app si no responden.
HA_URL=
HA_TOKEN=
GROCY_URL=
GROCY_API_KEY=

LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
