# Copiar a .env y rellenar. En desarrollo local, DATABASE_URL puede dejarse tal cual
# (SQLite). En producción (VPS), cambiar a una URL de Postgres, p.ej.:
# postgresql+asyncpg://usuario:contraseña@host:5432/ninumapp

DATABASE_URL=sqlite+aiosqlite:///./ninumapp.db

# Home Assistant y Grocy viven en la Raspberry -- se consultan por red, pero nunca
# bloquean el resto de la app si no responden.
HA_URL=
HA_TOKEN=
GROCY_URL=
GROCY_API_KEY=

# Gemini (capa gratuita, aistudio.google.com/apikey) para leer tickets/albaranes con
# la cámara en Inventario.
GEMINI_API_KEY=

# OAuth de Google (Gmail, solo lectura) -- ver services/gmail.py para el flujo de
# autorización única (no es login por usuario, es una sola cuenta de correo
# autorizada de antemano). client_id/secret desde Google Cloud Console -> Credenciales
# -> ID de cliente OAuth tipo "Aplicación de escritorio".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Rol de solo lectura dedicado en la Supabase de la web (ver
# supabase/migrations/038_rol_lectura_ninumapp.sql en el repo WBD) -- nunca la
# service_role key. Host desde Supabase -> Settings -> Database -> Connection string.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=ninumapp_lectura
SUPABASE_DB_PASSWORD=

LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# Generar uno de verdad en producción, p.ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=SOLO-PARA-DESARROLLO-CAMBIAR-EN-.ENV
ACCESS_TOKEN_MINUTOS=20
REFRESH_TOKEN_DIAS=60
