# Este .env es SOLO para el VPS (docker-compose lee POSTGRES_PASSWORD de aquí) --
# nada que ver con el .env.example de la raíz, que es para EXPO_PUBLIC_* en el
# ordenador de desarrollo. Copiar a ".env" en el propio VPS, en la misma carpeta que
# docker-compose.yml.

# Genera una contraseña de verdad, p.ej.: openssl rand -hex 24
POSTGRES_PASSWORD=
